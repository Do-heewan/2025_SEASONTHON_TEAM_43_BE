# 이 파일을 be/.env 로 복사한 뒤 값을 채워 넣으세요.  (cp .env.example .env)

# ---------- PostgreSQL ----------
# Docker Compose로 실행: crumb-postgres / 로컬에서 bootRun: localhost
POSTGRES_HOST=crumb-postgres
POSTGRES_PORT=5432
POSTGRES_DB=crumb
POSTGRES_USER=crumb
POSTGRES_PASSWORD=change-me

# ---------- Spring Boot ----------
SPRING_PORT=8080

# ---------- Kakao ----------
# 카카오 디벨로퍼스 > 내 애플리케이션 > 앱 키 / 카카오 로그인
# REST API 키 (OAuth client_id)
KAKAO_CLIENT_ID=
# 카카오 로그인 > 보안 > Client Secret
KAKAO_CLIENT_SECRET=
# 카카오 콘솔에 등록한 Redirect URI와 정확히 같아야 함 (프론트 콜백 주소)
KAKAO_REDIRECT_URI=http://localhost:3000/oauth/kakao
# REST API 키 (로컬 검색/지오코딩용, 보통 CLIENT_ID와 같은 값)
KAKAO_REST_API_KEY=

# ---------- Google (선택) ----------
GOOGLE_PLACES_API_KEY=

# ---------- FastAPI 추천 서버 ----------
# 반드시 http:// 스킴 포함, 포트는 붙이지 않음 (Spring이 ":8000"을 자동으로 붙임)
# Docker Compose로 실행: http://crumb-fastapi / 로컬: http://localhost
FASTAPI_HOST=http://crumb-fastapi
FASTAPI_PORT=8000
RECO_RADIUS_M=2000
RECO_LIMIT=10
# 컨테이너 시작 시 RECO_INPUT(원본 CSV)이 있으면 전처리(카카오 지오코딩)를 다시 돌려 RECO_OUTPUT을 덮어씁니다.
# 이미 정제된 bakeries_clean.csv를 그대로 쓰려면 존재하지 않는 경로를 지정해 전처리를 건너뛰세요.
RECO_INPUT=/app/data/bakeries_raw.csv
RECO_OUTPUT=/app/data/bakeries_clean.csv
